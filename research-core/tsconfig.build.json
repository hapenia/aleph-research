{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "test/**",
    "src/type-tests.ts",
    "src/__*",
    "src/**/__*",
    "src/release-gate.ts"
  ]
}
