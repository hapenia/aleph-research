{
  "name": "@local/dsh-aleph-superagent",
  "version": "0.1.0",
  "private": true,
  "description": "AlephResearch extension for dsh-superagent: research Source, evaluation, watchdog and panel.",
  "type": "module",
  "dependencies": {
    "zod": "4.4.3",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./request-tool": "./request-tool.js",
    "./research-host": "./research-host.js",
    "./research-sessions": "./research-sessions.js",
    "./research-storage": "./research-storage.js",
    "./research-tools": "./research-tools.js",
    "./research-trigger-bridge": "./research-trigger-bridge.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "research-extension.js",
    "request-tool.js",
    "research-host.js",
    "research-sessions.js",
    "research-storage.js",
    "research-tools.js",
    "research-trigger-bridge.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint": "node ../research-core/node_modules/eslint/bin/eslint.js ."
  }
}
